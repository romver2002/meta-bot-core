# Скопируй в .env и заполни. Реальные значения в репозиторий не коммитятся.
# Токены ботов сюда НЕ кладутся — они живут только в token vault
# (memory-bank/architecture/security.md).
# Полный реестр переменных — memory-bank/ops/configuration.md.

POSTGRES_USER=metabot
POSTGRES_PASSWORD=metabot
POSTGRES_DB=metabot

# Секрет вебхуков: сверяется с заголовком X-Telegram-Bot-Api-Secret-Token /
# X-Max-Bot-Api-Secret; пусто = проверка отключена (в prod обязателен).
WEBHOOK_SECRET=

# Публичный HTTPS-адрес приёма вебхуков (ADR-0014): при заданном значении
# publish сам регистрирует /webhooks/{platform}/{bot_id} у платформы.
# Пусто = регистрация вебхука остаётся ручной (dev без туннеля).
# WEBHOOK_BASE_URL=https://api.example.com

# Бэкапы PG (сервис pg-backup в compose): период дампа и срок хранения.
# BACKUP_INTERVAL=86400
# BACKUP_KEEP_DAYS=7

# Точные origin'ы отдельных web-фронтендов, которым разрешены браузерные POST
# к API. JSON-массив; пустой список = CORS выключен. Никогда не указывай "*".
CORS_ALLOWED_ORIGINS=[]
# Пример для dev-сервера mini app без Vite proxy:
# CORS_ALLOWED_ORIGINS=["http://127.0.0.1:5174","http://localhost:5174"]

# Для запуска API вне compose (Postgres проброшен на 5433 хоста):
# DATABASE_URL=postgresql+asyncpg://metabot:metabot@localhost:5433/metabot
# REDIS_URL=redis://localhost:6379/0

# Остальные переменные имеют безопасные дефолты в коде
# (src/infrastructure/config.py) — раскомментируй, чтобы переопределить.
# PROJECT_NAME=meta-bot-core
# PUBLIC_URL=http://localhost:8000
# WEBHOOK_IDEMPOTENCY_TTL=86400
# SESSION_IDLE_TTL=3600
# SESSION_RETENTION_DAYS=30
# SESSION_PURGE_INTERVAL=3600
# LOG_LEVEL=INFO
# LOG_DIR=logs

# Пути к dev-хранилищам секретов (сами пути — не секрет, содержимое — секрет,
# каталог .secrets/ в .gitignore):
# TOKEN_VAULT_FILE=.secrets/token-vault.json
# CONNECTION_SECRETS_FILE=.secrets/connections.json
# NOTIFICATION_TARGETS_FILE=.secrets/notification-targets.json
