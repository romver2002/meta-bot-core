{
  "name": "meta-bot-core-miniapp",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Platform-neutral Mini App runtime for Telegram and MAX",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build": "npm run typecheck && vite build && npm run check:bundle",
    "check:bundle": "node scripts/check-bundle.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
