# Пустое значение означает same-origin API; локально /api проксирует Vite.
# Для отдельного HTTPS-хостинга укажите публичный origin backend без завершающего /.
VITE_API_BASE_URL=

# bot_id передаётся только в URL запуска: ?bot_id=<uuid>.
# initData Telegram/MAX сюда не помещать: это секретные транзиентные данные.
